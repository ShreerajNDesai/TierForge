# TierForge Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit your actual .env file.

# -----------------------------------------------------------------------------
# Google Drive OAuth2 (Optional - for Cloud Save Backup & Restore)
# To obtain credentials:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a project and enable the "Google Drive API"
# 3. Create OAuth 2.0 Credentials (Web Application)
# 4. Set Authorized redirect URIs to: http://localhost:19847/callback
# -----------------------------------------------------------------------------
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=http://localhost:19847/callback

# -----------------------------------------------------------------------------
# Discord Rich Presence (Optional - defaults to TierForge Application ID)
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=1503747419811221604

# Note: In-app API keys (IGDB Client ID/Secret, Steam Web API Key, and Gemini API Key)
# can be entered directly in the TierForge application via the in-app Settings page.

